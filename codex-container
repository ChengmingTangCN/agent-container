#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

usage() {
  echo "Usage: $(basename "$0") [options] <project-directory>"
  echo
  echo "Run Codex CLI inside a Docker container."
  echo
  echo "Options:"
  echo "  --persistent  Keep and reuse the container after exit"
  echo "  --rebuild     Rebuild the image without cache"
  echo "  -h, --help    Show this help message"
}

PERSISTENT=0
REBUILD=0
PROJECT_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --persistent)
      PERSISTENT=1
      shift
      ;;
    --rebuild)
      REBUILD=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
    *)
      if [[ -n "$PROJECT_ARG" ]]; then
        echo "Unexpected argument: $1"
        usage
        exit 1
      fi
      PROJECT_ARG="$1"
      shift
      ;;
  esac
done

for ARG in "$@"; do
  if [[ -n "$PROJECT_ARG" ]]; then
    echo "Unexpected argument: $ARG"
    usage
    exit 1
  fi
  PROJECT_ARG="$ARG"
done

if [[ -z "$PROJECT_ARG" ]]; then
  usage
  exit 1
fi

PROJECT="$(realpath "$PROJECT_ARG")"

if [[ ! -e "$PROJECT" ]]; then
  echo "Project path does not exist: $PROJECT"
  exit 1
fi

if [[ ! -d "$PROJECT" ]]; then
  echo "Project path is not a directory: $PROJECT"
  exit 1
fi

if [[ "$PROJECT" == "/" ]]; then
  echo "Refusing to mount /"
  exit 1
fi

DOCKERFILE="$SCRIPT_DIR/Dockerfile"

if [[ ! -f "$DOCKERFILE" ]]; then
  echo "Dockerfile not found: $DOCKERFILE"
  exit 1
fi

UID_HOST="$(id -u)"
GID_HOST="$(id -g)"

PROJECT_NAME="$(basename "$PROJECT")"
PROJECT_HASH="$(echo -n "$PROJECT" | sha1sum | cut -c1-8)"
IMAGE_REVISION="$(sha256sum "$DOCKERFILE" | cut -c1-12)"

IMAGE="codex-dev:npm-local-${IMAGE_REVISION}-uid-${UID_HOST}-gid-${GID_HOST}"
CONTAINER_NAME="codex-${PROJECT_NAME}-${PROJECT_HASH}"
CODEX_HOME="$HOME/.codex-container"
WORKDIR_IN_CONTAINER="/work/${PROJECT_NAME}"
LIFETIME="temporary"

HTTP_PROXY_VALUE="${http_proxy:-${HTTP_PROXY:-}}"
HTTPS_PROXY_VALUE="${https_proxy:-${HTTPS_PROXY:-}}"
NO_PROXY_SOURCE="${no_proxy:-${NO_PROXY:-}}"
NO_PROXY_VALUE="${NO_PROXY_SOURCE:-localhost,127.0.0.1,::1}"

if [[ "$PERSISTENT" -eq 1 ]]; then
  LIFETIME="persistent"
fi

TMUX_CONF="$HOME/.tmux.conf"
TMUX_CONF_MOUNT=()

if [[ -f "$TMUX_CONF" ]]; then
  TMUX_CONF_MOUNT=(-v "$TMUX_CONF:/home/dev/.tmux.conf:ro")
fi

if [[ ! -d "$CODEX_HOME" ]]; then
  echo "Creating Codex config directory: $CODEX_HOME"
  mkdir -p "$CODEX_HOME"
fi

OPENCODE_CONFIG_DIR="$CODEX_HOME/opencode/config"
OPENCODE_DATA_DIR="$CODEX_HOME/opencode/data"
OPENCODE_STATE_DIR="$CODEX_HOME/opencode/state"

for OPENCODE_DIR in "$OPENCODE_CONFIG_DIR" "$OPENCODE_DATA_DIR" "$OPENCODE_STATE_DIR"; do
  if [[ ! -d "$OPENCODE_DIR" ]]; then
    echo "Creating OpenCode config directory: $OPENCODE_DIR"
    mkdir -p "$OPENCODE_DIR"
  fi
done

PI_CONFIG_DIR="$CODEX_HOME/pi"

if [[ ! -d "$PI_CONFIG_DIR" ]]; then
  echo "Creating Pi config directory: $PI_CONFIG_DIR"
  mkdir -p "$PI_CONFIG_DIR"
fi

CODEX_AGENTS="$CODEX_HOME/AGENTS.md"
OPENCODE_AGENTS="$OPENCODE_CONFIG_DIR/AGENTS.md"

if [[ -f "$CODEX_AGENTS" ]]; then
  if [[ -L "$OPENCODE_AGENTS" ]] && [[ ! -e "$OPENCODE_AGENTS" ]]; then
    echo "Replacing broken AGENTS.md symlink: $OPENCODE_AGENTS"
    rm "$OPENCODE_AGENTS"
  fi
  if [[ ! -e "$OPENCODE_AGENTS" ]]; then
    echo "Linking shared AGENTS.md into opencode config: $OPENCODE_AGENTS"
    ln -s /home/dev/.codex/AGENTS.md "$OPENCODE_AGENTS"
  fi
fi

GITCONFIG="$HOME/.gitconfig"
GITCONFIG_MOUNT=()

if [[ -f "$GITCONFIG" ]]; then
  GITCONFIG_MOUNT=(-v "$GITCONFIG:/home/dev/.gitconfig:ro")
fi

OPENCODE_MOUNTS=(
  -v "$OPENCODE_CONFIG_DIR:/home/dev/.config/opencode"
  -v "$OPENCODE_DATA_DIR:/home/dev/.local/share/opencode"
  -v "$OPENCODE_STATE_DIR:/home/dev/.local/state/opencode"
)

PI_MOUNTS=(
  -v "$PI_CONFIG_DIR:/home/dev/.pi"
)

echo "Codex container config:"
echo "  uid:        $UID_HOST"
echo "  gid:        $GID_HOST"
echo "  project:    $PROJECT"
echo "  workdir:    $WORKDIR_IN_CONTAINER"
echo "  codex home: $CODEX_HOME"
echo "  opencode config: $OPENCODE_CONFIG_DIR"
echo "  opencode data:   $OPENCODE_DATA_DIR"
echo "  opencode state:  $OPENCODE_STATE_DIR"
echo "  pi config:       $PI_CONFIG_DIR"
echo "  image:      $IMAGE"
echo "  container:  $CONTAINER_NAME"
echo "  lifetime:   $LIFETIME"
if [[ -f "$TMUX_CONF" ]]; then
  echo "  tmux conf:  $TMUX_CONF"
else
  echo "  tmux conf:  not found"
fi
if [[ -f "$GITCONFIG" ]]; then
  echo "  gitconfig:  $GITCONFIG"
else
  echo "  gitconfig:  not found"
fi
if [[ -f "$CODEX_AGENTS" ]]; then
  echo "  shared AGENTS.md (codex+opencode): $CODEX_AGENTS"
else
  echo "  shared AGENTS.md: not found"
fi
echo

if [[ "$REBUILD" -eq 1 ]] && docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
  echo "Removing existing container for rebuild: $CONTAINER_NAME"
  docker rm -f "$CONTAINER_NAME" >/dev/null
fi

if [[ "$PERSISTENT" -eq 1 ]] && docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
  echo "Persistent container found: $CONTAINER_NAME"
  CURRENT_IMAGE="$(docker inspect -f '{{.Config.Image}}' "$CONTAINER_NAME")"
  if [[ "$CURRENT_IMAGE" != "$IMAGE" ]]; then
    echo "Warning: persistent container uses an outdated image: $CURRENT_IMAGE"
    echo "Run again with --rebuild to recreate it from: $IMAGE"
  fi
  if [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" == "true" ]]; then
    echo "Attaching to running container: $CONTAINER_NAME"
    docker attach "$CONTAINER_NAME"
  else
    echo "Starting persistent container: $CONTAINER_NAME"
    docker start -ai "$CONTAINER_NAME"
  fi
  exit $?
fi

BUILD_OPTIONS=()
BUILD_PROXY_ARGS=()

if [[ "$REBUILD" -eq 1 ]]; then
  BUILD_OPTIONS+=(--no-cache)
fi

if [[ -n "$HTTP_PROXY_VALUE" ]]; then
  BUILD_PROXY_ARGS+=(--build-arg "HTTP_PROXY=$HTTP_PROXY_VALUE")
fi

if [[ -n "$HTTPS_PROXY_VALUE" ]]; then
  BUILD_PROXY_ARGS+=(--build-arg "HTTPS_PROXY=$HTTPS_PROXY_VALUE")
fi

if [[ -n "$NO_PROXY_SOURCE" ]]; then
  BUILD_PROXY_ARGS+=(--build-arg "NO_PROXY=$NO_PROXY_SOURCE")
fi

if [[ "$REBUILD" -eq 1 ]] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  if [[ "$REBUILD" -eq 1 ]]; then
    echo "Rebuilding image: $IMAGE"
  else
    echo "Image not found, building: $IMAGE"
  fi
  docker build "${BUILD_OPTIONS[@]}" \
    --network host \
    "${BUILD_PROXY_ARGS[@]}" \
    --build-arg UID="$UID_HOST" \
    --build-arg GID="$GID_HOST" \
    -t "$IMAGE" \
    "$SCRIPT_DIR"
else
  echo "Image found: $IMAGE"
fi

echo
echo "Starting $LIFETIME container: $CONTAINER_NAME"

RUN_REMOVE=(--rm)

if [[ "$PERSISTENT" -eq 1 ]]; then
  RUN_REMOVE=()
fi

docker run "${RUN_REMOVE[@]}" -it \
  --name "$CONTAINER_NAME" \
  --network host \
  --cap-add=SYS_PTRACE \
  --security-opt seccomp=unconfined \
  -e http_proxy="$HTTP_PROXY_VALUE" \
  -e https_proxy="$HTTPS_PROXY_VALUE" \
  -e HTTP_PROXY="$HTTP_PROXY_VALUE" \
  -e HTTPS_PROXY="$HTTPS_PROXY_VALUE" \
  -e no_proxy="$NO_PROXY_VALUE" \
  -e NO_PROXY="$NO_PROXY_VALUE" \
  -e TERM="${TERM:-xterm-256color}" \
  -e COLORTERM="${COLORTERM:-truecolor}" \
  -e LANG="en_US.UTF-8" \
  -e LANGUAGE="en_US:en" \
  -e LC_ALL="en_US.UTF-8" \
  -v "$PROJECT:$WORKDIR_IN_CONTAINER" \
  -v "$CODEX_HOME:/home/dev/.codex" \
  "${OPENCODE_MOUNTS[@]}" \
  "${PI_MOUNTS[@]}" \
  "${TMUX_CONF_MOUNT[@]}" \
  "${GITCONFIG_MOUNT[@]}" \
  -w "$WORKDIR_IN_CONTAINER" \
  "$IMAGE"
