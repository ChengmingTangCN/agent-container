#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options]

Run Steam in a dedicated Docker container with host GPU and audio access.

Options:
  --check                Check GPU, audio, display, and nested sandboxing only
  --skip-check           Start Steam without the runtime preflight
  --rebuild              Rebuild the image and replace this Steam container
  --library DIR          Mount another Steam library (may be repeated)
  --host-network         Share the host network (default)
  --bridge-network       Use Docker bridge networking instead
  --apparmor-profile P   Docker AppArmor profile (default: agent-container-steam)
  --no-apparmor-profile  Use Docker's default AppArmor profile
  -h, --help             Show this help
USAGE
}

REBUILD=0
CHECK_ONLY=0
SKIP_CHECK=0
HOST_NETWORK=1
LIBRARY_PATHS=()
APPARMOR_PROFILE="${STEAM_CONTAINER_APPARMOR_PROFILE:-agent-container-steam}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild) REBUILD=1; shift ;;
    --check) CHECK_ONLY=1; shift ;;
    --skip-check) SKIP_CHECK=1; shift ;;
    --host-network) HOST_NETWORK=1; shift ;;
    --bridge-network) HOST_NETWORK=0; shift ;;
    --library)
      [[ $# -ge 2 && -d "$2" ]] || {
        echo "--library requires an existing directory" >&2
        exit 2
      }
      LIBRARY_PATHS+=("$(realpath -e -- "$2")")
      shift 2
      ;;
    --apparmor-profile)
      [[ $# -ge 2 && -n "$2" ]] || {
        echo "--apparmor-profile requires a profile name" >&2
        exit 2
      }
      APPARMOR_PROFILE="$2"
      shift 2
      ;;
    --no-apparmor-profile) APPARMOR_PROFILE="none"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) echo "Unexpected argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ $# -eq 0 ]] || { echo "Unexpected argument: $1" >&2; exit 2; }

DOCKERFILE="${SCRIPT_DIR}/steam/Dockerfile"
ENTRYPOINT_FILE="${SCRIPT_DIR}/steam/entrypoint.sh"
[[ -f "${DOCKERFILE}" && -f "${ENTRYPOINT_FILE}" ]] || {
  echo "Steam Dockerfile or entrypoint is missing." >&2
  exit 1
}

UID_HOST="$(id -u)"
GID_HOST="$(id -g)"
IMAGE_REVISION="$({
  cat "${DOCKERFILE}" "${ENTRYPOINT_FILE}"
} | sha256sum | cut -c1-12)"
IMAGE="agent-steam:${IMAGE_REVISION}-uid-${UID_HOST}-gid-${GID_HOST}"
CONTAINER_NAME="agent-steam-${UID_HOST}"
DATA_ROOT="$(realpath -m -- "${AGENT_CONTAINER_DATA_DIR:-$HOME/.agent-container}")"
STATE_ROOT="${DATA_ROOT}/steam"
CONTAINER_HOME="${STATE_ROOT}/home"

mkdir -p -- "${STATE_ROOT}" "${CONTAINER_HOME}"
chmod 700 -- "${STATE_ROOT}" "${CONTAINER_HOME}"

BUILD_PROXY_ARGS=()
PROXY_ARGS=()
for PROXY_NAME in HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY; do
  LOWER_NAME="${PROXY_NAME,,}"
  PROXY_VALUE="${!LOWER_NAME:-${!PROXY_NAME:-}}"
  if [[ -n "${PROXY_VALUE}" ]]; then
    BUILD_PROXY_ARGS+=(--build-arg "${PROXY_NAME}=${PROXY_VALUE}")
    if [[ "${HOST_NETWORK}" -eq 0 ]] \
        && [[ "${PROXY_VALUE}" =~ ^[A-Za-z][A-Za-z0-9+.-]*://([^/@]*@)?(127(\.[0-9]+){3}|localhost|\[::1\])(:[0-9]+)?/?$ ]]; then
      echo "Ignoring host-local ${PROXY_NAME} in the bridged container." >&2
      echo "Use --host-network if the container must use that proxy." >&2
    else
      PROXY_ARGS+=(-e "${LOWER_NAME}=${PROXY_VALUE}" -e "${PROXY_NAME}=${PROXY_VALUE}")
    fi
  fi
done

SECURITY_ARGS=(--security-opt seccomp=unconfined)
APPARMOR_ENABLED="$(
  cat /sys/module/apparmor/parameters/enabled 2>/dev/null || true
)"
USERNS_RESTRICTED="$(
  cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || true
)"
if [[ "${APPARMOR_ENABLED}" == "Y" && "${USERNS_RESTRICTED}" == "1" \
    && "${APPARMOR_PROFILE}" != "none" ]]; then
  PROFILE_FILE="/etc/apparmor.d/${APPARMOR_PROFILE}"
  if [[ ! -f "${PROFILE_FILE}" ]]; then
    echo "Required AppArmor profile is not installed: ${APPARMOR_PROFILE}" >&2
    echo "Install it once with: sudo ${SCRIPT_DIR}/steam/install-apparmor-profile.sh" >&2
    exit 1
  fi
  SECURITY_ARGS+=(--security-opt "apparmor=${APPARMOR_PROFILE}")
fi

RUNTIME_ARGS=(
  --hostname "${CONTAINER_NAME}"
  --label "agent-steam.schema=1"
  --label "agent-steam.image=${IMAGE}"
  --init
  --shm-size=1g
  "${SECURITY_ARGS[@]}"
  "${PROXY_ARGS[@]}"
  -e "TERM=${TERM:-xterm-256color}"
  -e "COLORTERM=${COLORTERM:-truecolor}"
  -v "${CONTAINER_HOME}:/home/dev"
)

DRI_FOUND=0
if [[ -d /dev/dri ]] && find /dev/dri -maxdepth 1 -type c -print -quit | grep -q .; then
  RUNTIME_ARGS+=(--device /dev/dri)
  DRI_FOUND=1
  while IFS= read -r DRI_GID; do
    [[ -n "${DRI_GID}" ]] || continue
    RUNTIME_ARGS+=(--group-add "${DRI_GID}")
  done < <(find /dev/dri -maxdepth 1 -type c -printf '%G\n' | sort -nu)
fi

NVIDIA_FOUND=0
if [[ -c /dev/nvidia0 ]] && command -v nvidia-smi >/dev/null 2>&1; then
  NVIDIA_FOUND=1
  RUNTIME_ARGS+=(
    --gpus all
    -e NVIDIA_DRIVER_CAPABILITIES=all
    -e NVIDIA_VISIBLE_DEVICES=all
  )
fi

if [[ "${DRI_FOUND}" -eq 1 || "${NVIDIA_FOUND}" -eq 1 ]]; then
  RUNTIME_ARGS+=(-e STEAM_REQUIRE_HARDWARE_GPU=1)
fi

if [[ -n "${DISPLAY:-}" ]]; then
  DISPLAY_NUMBER="${DISPLAY#*:}"
  DISPLAY_NUMBER="${DISPLAY_NUMBER%%.*}"
  X_SOCKET="/tmp/.X11-unix/X${DISPLAY_NUMBER}"
  RUNTIME_ARGS+=(-e "DISPLAY=${DISPLAY}")
  if [[ -S "${X_SOCKET}" ]]; then
    RUNTIME_ARGS+=(-v "${X_SOCKET}:${X_SOCKET}:ro")
  elif [[ -d /tmp/.X11-unix ]]; then
    RUNTIME_ARGS+=(-v "/tmp/.X11-unix:/tmp/.X11-unix:ro")
  fi
fi

XAUTHORITY_FILE="${XAUTHORITY:-${HOME}/.Xauthority}"
if [[ -f "${XAUTHORITY_FILE}" ]]; then
  RUNTIME_ARGS+=(
    -v "${XAUTHORITY_FILE}:/run/steam/xauthority:ro"
    -e "XAUTHORITY=/run/steam/xauthority"
  )
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID_HOST}}"
PULSE_SOCKET="${RUNTIME_DIR}/pulse/native"
if [[ -S "${PULSE_SOCKET}" ]]; then
  RUNTIME_ARGS+=(
    -v "${PULSE_SOCKET}:/run/steam/pulse-native:ro"
    -e "PULSE_SERVER=unix:/run/steam/pulse-native"
  )
fi
PULSE_COOKIE_FILE="${PULSE_COOKIE:-${HOME}/.config/pulse/cookie}"
if [[ -f "${PULSE_COOKIE_FILE}" ]]; then
  RUNTIME_ARGS+=(
    -v "${PULSE_COOKIE_FILE}:/run/steam/pulse-cookie:ro"
    -e "PULSE_COOKIE=/run/steam/pulse-cookie"
  )
fi

for LIBRARY_PATH in "${LIBRARY_PATHS[@]}"; do
  if [[ "${LIBRARY_PATH}" == *:* || "${LIBRARY_PATH}" == *$'\n'* ]]; then
    echo "Library paths must not contain colons or newlines: ${LIBRARY_PATH}" >&2
    exit 1
  fi
  LIBRARY_NAME="$(basename "${LIBRARY_PATH}")"
  LIBRARY_NAME="$(printf '%s' "${LIBRARY_NAME}" \
    | LC_ALL=C sed -E 's/[^A-Za-z0-9_.-]+/-/g' | cut -c1-48)"
  LIBRARY_HASH="$(printf '%s' "${LIBRARY_PATH}" | sha1sum | cut -c1-8)"
  RUNTIME_ARGS+=(-v "${LIBRARY_PATH}:/home/dev/SteamLibrary-${LIBRARY_NAME:-library}-${LIBRARY_HASH}")
done

if [[ "${HOST_NETWORK}" -eq 1 ]]; then
  RUNTIME_ARGS+=(--network host)
fi

echo "State:     ${CONTAINER_HOME}"
echo "Container: ${CONTAINER_NAME}"
echo "Image:     ${IMAGE}"
if [[ "${DRI_FOUND}" -eq 1 && "${NVIDIA_FOUND}" -eq 1 ]]; then
  echo "GPU:       /dev/dri + NVIDIA Container Toolkit"
elif [[ "${DRI_FOUND}" -eq 1 ]]; then
  echo "GPU:       /dev/dri"
elif [[ "${NVIDIA_FOUND}" -eq 1 ]]; then
  echo "GPU:       NVIDIA Container Toolkit"
else
  echo "GPU:       none detected"
fi

if [[ "${REBUILD}" -eq 1 ]] || ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
  BUILD_CACHE_ARGS=()
  if [[ "${REBUILD}" -eq 1 ]]; then
    BUILD_CACHE_ARGS+=(--no-cache)
  fi
  DOCKER_BUILDKIT=1 docker build \
    "${BUILD_CACHE_ARGS[@]}" \
    --network host "${BUILD_PROXY_ARGS[@]}" \
    --build-arg UID="${UID_HOST}" --build-arg GID="${GID_HOST}" \
    -t "${IMAGE}" "${SCRIPT_DIR}/steam"
fi

if [[ "${SKIP_CHECK}" -eq 0 ]]; then
  echo "Checking display, audio, GPU, and Steam Runtime sandboxing..."
  if ! docker run --rm "${RUNTIME_ARGS[@]}" "${IMAGE}" check; then
    echo "Steam runtime check failed. No Steam window was started." >&2
    exit 1
  fi
fi
[[ "${CHECK_ONLY}" -eq 0 ]] || exit 0

CONTAINER_EXISTS=0
if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
  CONTAINER_EXISTS=1
  SCHEMA="$(docker inspect -f '{{ index .Config.Labels "agent-steam.schema" }}' "${CONTAINER_NAME}")"
  if [[ "${SCHEMA}" != "1" ]]; then
    echo "Existing container is not owned by this launcher: ${CONTAINER_NAME}" >&2
    echo "Remove it before continuing." >&2
    exit 1
  fi
fi

if [[ "${REBUILD}" -eq 1 && "${CONTAINER_EXISTS}" -eq 1 ]]; then
  docker rm -f "${CONTAINER_NAME}" >/dev/null
  CONTAINER_EXISTS=0
fi

if [[ "${CONTAINER_EXISTS}" -eq 1 ]]; then
  CURRENT_IMAGE="$(docker inspect -f '{{.Config.Image}}' "${CONTAINER_NAME}")"
  if [[ "${CURRENT_IMAGE}" != "${IMAGE}" ]]; then
    echo "The existing Steam container uses a different image; reusing it." >&2
    echo "Use --rebuild to replace it with the current image." >&2
  fi
  RUNNING="$(docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}")"
  if [[ "${RUNNING}" == "true" ]]; then
    docker attach "${CONTAINER_NAME}"
  else
    docker rm "${CONTAINER_NAME}" >/dev/null
    CONTAINER_EXISTS=0
  fi
fi

docker run -it --name "${CONTAINER_NAME}" "${RUNTIME_ARGS[@]}" "${IMAGE}"
