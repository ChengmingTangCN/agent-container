#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options] <project-directory>

Start a project container locally. Use the upstream HAPI PWA for agent sessions.

Options:
  --hapi        Start a persistent HAPI Runner container in the background
  --persistent  Keep and reuse an interactive container after exit
  --rebuild     Rebuild the image and replace this project's container
  --env-file F  Pass a Docker env file to the container (provider keys, etc.)
  -h, --help    Show this help
USAGE
}

PERSISTENT=0
REBUILD=0
HAPI_RUNNER=0
ENV_ARGS=()
PROJECT_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --persistent) PERSISTENT=1; shift ;;
    --rebuild) REBUILD=1; shift ;;
    --hapi) HAPI_RUNNER=1; PERSISTENT=1; shift ;;
    --env-file)
      [[ $# -ge 2 && -f "$2" && -r "$2" ]] || { echo "--env-file requires a readable file" >&2; exit 2; }
      ENV_ARGS+=(--env-file "$(realpath -e -- "$2")")
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)
      [[ -z "$PROJECT_ARG" ]] || { echo "Unexpected argument: $1" >&2; exit 2; }
      PROJECT_ARG="$1"
      shift
      ;;
  esac
done
for ARG in "$@"; do
  [[ -z "$PROJECT_ARG" ]] || { echo "Unexpected argument: $ARG" >&2; exit 2; }
  PROJECT_ARG="$ARG"
done
[[ -n "$PROJECT_ARG" ]] || { usage >&2; exit 2; }
[[ -d "$PROJECT_ARG" ]] || { echo "Project directory does not exist: $PROJECT_ARG" >&2; exit 1; }
PROJECT="$(realpath -e -- "$PROJECT_ARG")"
[[ "$PROJECT" != / ]] || { echo "Refusing to mount /" >&2; exit 1; }
HOST_HOME="$(realpath -e -- "$HOME")"
if [[ "$HOST_HOME" == "$PROJECT" || "$HOST_HOME" == "$PROJECT/"* ]]; then
  echo "Refusing to mount the host home directory or its parents" >&2
  exit 1
fi
for PRIVATE_DIR in "$HOST_HOME/.ssh" "$HOST_HOME/.gnupg"; do
  PRIVATE_DIR="$(realpath -m -- "$PRIVATE_DIR")"
  if [[ "$PROJECT" == "$PRIVATE_DIR" || "$PROJECT" == "$PRIVATE_DIR/"* ]]; then
    echo "Refusing to use a credential directory as the project: $PROJECT" >&2
    exit 1
  fi
done

DOCKERFILE="$SCRIPT_DIR/Dockerfile"
[[ -f "$DOCKERFILE" ]] || { echo "Dockerfile not found: $DOCKERFILE" >&2; exit 1; }
UID_HOST="$(id -u)"
GID_HOST="$(id -g)"
PROJECT_NAME="$(basename "$PROJECT")"
PROJECT_HASH="$(printf '%s' "$PROJECT" | sha1sum | cut -c1-8)"
PROJECT_SLUG="$(printf '%s' "$PROJECT_NAME" | LC_ALL=C sed -E 's/[^A-Za-z0-9_.-]+/-/g' | cut -c1-48)"
IMAGE_REVISION="$(sha256sum "$DOCKERFILE" | cut -c1-12)"
IMAGE="agent-container:${IMAGE_REVISION}-uid-${UID_HOST}-gid-${GID_HOST}"
CONTAINER_NAME="agent-${PROJECT_SLUG:-project}-${PROJECT_HASH}"
WORKDIR_IN_CONTAINER="/work/$PROJECT_NAME"
DATA_ROOT="$(realpath -m -- "${AGENT_CONTAINER_DATA_DIR:-$HOME/.agent-container}")"
if [[ "$DATA_ROOT" == "$PROJECT" || "$DATA_ROOT" == "$PROJECT/"* || "$PROJECT" == "$DATA_ROOT/"* ]]; then
  echo "The project and shared state directory must not overlap: $DATA_ROOT" >&2
  exit 1
fi
# Docker's -v syntax uses ':' as a delimiter; do not interpret it as mount options.
for MOUNT_PATH in "$PROJECT" "$DATA_ROOT" "$HOME"; do
  if [[ "$MOUNT_PATH" == *:* || "$MOUNT_PATH" == *$'\n'* ]]; then
    echo "Mount paths must not contain colons or newlines" >&2
    exit 1
  fi
done
PROJECT_STATE_ROOT="$DATA_ROOT/projects/$PROJECT_HASH"
PROJECT_CODEX_DIR="$PROJECT_STATE_ROOT/codex"
PROJECT_HAPI_DIR="$PROJECT_STATE_ROOT/hapi"
# State paths relative to the project state root and container home.
STATE_MOUNTS=(
  codex:.codex
  hapi:.hapi
  opencode/config:.config/opencode
  opencode/data:.local/share/opencode
  opencode/state:.local/state/opencode
  pi:.pi
)
MODE="shell"
[[ "$HAPI_RUNNER" -eq 0 ]] || MODE="hapi"

clear_runner_process_state() {
  # The previous container's PIDs cannot identify processes in a fresh start.
  # Keep settings.json (credentials and machine identity) untouched.
  rm -f -- "$PROJECT_HAPI_DIR/runner.state.json" "$PROJECT_HAPI_DIR/runner.state.json.lock"
}

check_runner() {
  echo "Waiting for Hub authentication and Runner RPC readiness (up to 45 seconds)..."
  if ! docker exec -i "$CONTAINER_NAME" python3 - ready < "$SCRIPT_DIR/hapi-setup.py"; then
    echo "Runner is not ready. Inspect: docker logs $CONTAINER_NAME" >&2
    echo "If the container is running, repair credentials: docker exec -it $CONTAINER_NAME hapi auth login" >&2
    echo "For URL, token environment, or proxy changes, remove and recreate the container; mounted state is kept." >&2
    return 1
  fi
  echo "Agent login/setup: docker exec -it $CONTAINER_NAME bash"
  echo "  Codex: codex login --device-auth (or codex login); check: codex login status"
  echo "  API key for Codex: printenv OPENAI_API_KEY | codex login --with-api-key"
  echo "  Pi: pi, then /login and /model; OpenCode: opencode auth login"
  echo "Hub readiness does not verify provider credentials, quota, or model access. See docs/agents.md."
}

CONTAINER_EXISTS=0
if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
  CONTAINER_EXISTS=1
  SCHEMA="$(docker inspect -f '{{ index .Config.Labels "agent-container.schema" }}' "$CONTAINER_NAME")"
  OLD_PROJECT="$(docker inspect -f '{{ index .Config.Labels "agent-container.project" }}' "$CONTAINER_NAME")"
  OLD_MODE="$(docker inspect -f '{{ index .Config.Labels "agent-container.mode" }}' "$CONTAINER_NAME")"
  if [[ "$SCHEMA" != 3 || "$OLD_PROJECT" != "$PROJECT" ]]; then
    echo "Existing container uses an old or unrelated layout: $CONTAINER_NAME" >&2
    echo "Stop and remove that container locally before continuing; keep its project and state directories." >&2
    exit 1
  fi
  if [[ "$OLD_MODE" != "$MODE" && "$REBUILD" -eq 0 ]]; then
    echo "Existing container uses $OLD_MODE mode. Remove it locally before switching modes." >&2
    exit 1
  fi
fi

# Only selected reusable agent files are seeded. Never copy another project's
# sessions or HAPI machine identity, and never mount DATA_ROOT into a container.
NEW_PROJECT_STATE=0
[[ -d "$PROJECT_STATE_ROOT" ]] || NEW_PROJECT_STATE=1
for STATE_PATH in "$DATA_ROOT" "$DATA_ROOT/projects" "$PROJECT_STATE_ROOT" \
  "$PROJECT_STATE_ROOT/pi/agent"; do
  mkdir -p -- "$STATE_PATH"
  chmod 700 "$STATE_PATH"
done
STATE_ARGS=()
for MOUNT in "${STATE_MOUNTS[@]}"; do
  STATE_PATH="$PROJECT_STATE_ROOT/${MOUNT%%:*}"
  mkdir -p -- "$STATE_PATH"
  chmod 700 "$STATE_PATH"
  STATE_ARGS+=(-v "$STATE_PATH:/home/dev/${MOUNT#*:}")
done
if [[ "$NEW_PROJECT_STATE" -eq 1 ]]; then
  for CONFIG_NAME in auth.json config.toml; do
    for SEED_DIR in "$DATA_ROOT/seed/codex" "$DATA_ROOT"; do
      if [[ -f "$SEED_DIR/$CONFIG_NAME" ]]; then
        install -m 600 "$SEED_DIR/$CONFIG_NAME" "$PROJECT_CODEX_DIR/$CONFIG_NAME"
        break
      fi
    done
  done
  for CONFIG_NAME in auth.json settings.json models.json; do
    if [[ -f "$DATA_ROOT/seed/pi/$CONFIG_NAME" ]]; then
      install -m 600 "$DATA_ROOT/seed/pi/$CONFIG_NAME" "$PROJECT_STATE_ROOT/pi/agent/$CONFIG_NAME"
    fi
  done
  if [[ -f "$DATA_ROOT/seed/opencode/auth.json" ]]; then
    install -m 600 "$DATA_ROOT/seed/opencode/auth.json" "$PROJECT_STATE_ROOT/opencode/data/auth.json"
  fi
  if [[ -f "$DATA_ROOT/seed/opencode/opencode.json" ]]; then
    install -m 600 "$DATA_ROOT/seed/opencode/opencode.json" "$PROJECT_STATE_ROOT/opencode/config/opencode.json"
  fi
  if [[ -f "$DATA_ROOT/seed/AGENTS.md" ]]; then
    for AGENTS_FILE in "$PROJECT_CODEX_DIR/AGENTS.md" \
      "$PROJECT_STATE_ROOT/opencode/config/AGENTS.md" \
      "$PROJECT_STATE_ROOT/pi/agent/AGENTS.md"; do
      install -m 600 "$DATA_ROOT/seed/AGENTS.md" "$AGENTS_FILE"
    done
  fi
fi
BUILD_OPTIONS=()
[[ "$REBUILD" -eq 0 ]] || BUILD_OPTIONS+=(--no-cache)
BUILD_PROXY_ARGS=()
PROXY_ARGS=()
for PROXY_NAME in HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY; do
  LOWER_NAME="${PROXY_NAME,,}"
  PROXY_VALUE="${!LOWER_NAME:-${!PROXY_NAME:-}}"
  if [[ -n "$PROXY_VALUE" ]]; then
    BUILD_PROXY_ARGS+=(--build-arg "$PROXY_NAME=$PROXY_VALUE")
    PROXY_ARGS+=(-e "$LOWER_NAME=$PROXY_VALUE" -e "$PROXY_NAME=$PROXY_VALUE")
  fi
done

echo "Project:   $PROJECT"
echo "State:     $PROJECT_STATE_ROOT"
echo "Container: $CONTAINER_NAME"
echo "Image:     $IMAGE"
echo "Mode:      $MODE"

if [[ "$REBUILD" -eq 1 ]] || { [[ "$CONTAINER_EXISTS" -eq 0 ]] && ! docker image inspect "$IMAGE" >/dev/null 2>&1; }; then
  docker build "${BUILD_OPTIONS[@]}" --network host "${BUILD_PROXY_ARGS[@]}" \
    --build-arg UID="$UID_HOST" --build-arg GID="$GID_HOST" -t "$IMAGE" "$SCRIPT_DIR"
fi
# Preserve the old container if the replacement image fails to build.
if [[ "$REBUILD" -eq 1 && "$CONTAINER_EXISTS" -eq 1 ]]; then
  docker rm -f "$CONTAINER_NAME" >/dev/null
  CONTAINER_EXISTS=0
fi
if [[ "$CONTAINER_EXISTS" -eq 1 ]]; then
  if [[ ${#ENV_ARGS[@]} -gt 0 ]]; then
    echo "An existing container keeps its original environment. Remove it before applying --env-file." >&2
    exit 1
  fi
  CURRENT_IMAGE="$(docker inspect -f '{{.Config.Image}}' "$CONTAINER_NAME")"
  if [[ "$CURRENT_IMAGE" != "$IMAGE" ]]; then
    echo "Existing container uses an older image. Use --rebuild to replace it." >&2
  fi
  RUNNING="$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")"
  if [[ "$HAPI_RUNNER" -eq 1 ]]; then
    if [[ "$RUNNING" != true ]]; then
      clear_runner_process_state
      docker start "$CONTAINER_NAME" >/dev/null
    fi
    check_runner
  elif [[ "$PERSISTENT" -eq 1 ]]; then
    if [[ "$RUNNING" == true ]]; then
      docker attach "$CONTAINER_NAME"
    else
      clear_runner_process_state
      docker start -ai "$CONTAINER_NAME"
    fi
  else
    echo "Container already exists. Use --persistent to reuse it or remove it locally." >&2
    exit 1
  fi
  exit 0
fi

RUNTIME_ARGS=(
  --name "$CONTAINER_NAME" --hostname "$CONTAINER_NAME"
  --add-host "$CONTAINER_NAME:127.0.1.1"
  --label "agent-container.schema=3" --label "agent-container.project=$PROJECT"
  --label "agent-container.mode=$MODE"
  --network host --cap-add=SYS_PTRACE --security-opt seccomp=unconfined
  "${PROXY_ARGS[@]}" "${ENV_ARGS[@]}" "${STATE_ARGS[@]}"
  -e "TERM=${TERM:-xterm-256color}" -e "COLORTERM=${COLORTERM:-truecolor}"
  -v "$PROJECT:$WORKDIR_IN_CONTAINER"
  -w "$WORKDIR_IN_CONTAINER"
)
[[ -z "${HAPI_API_URL:-}" ]] || RUNTIME_ARGS+=(-e "HAPI_API_URL=$HAPI_API_URL")
for SHARED_CONFIG in .tmux.conf .gitconfig; do
  if [[ -f "$HOME/$SHARED_CONFIG" ]]; then
    RUNTIME_ARGS+=(-v "$HOME/$SHARED_CONFIG:/home/dev/$SHARED_CONFIG:ro")
  fi
done
clear_runner_process_state
if [[ "$HAPI_RUNNER" -eq 1 ]]; then
  SETUP_TTY=()
  [[ ! -t 0 || ! -t 1 ]] || SETUP_TTY=(-it)
  SETUP_ENV=("${PROXY_ARGS[@]}" "${ENV_ARGS[@]}")
  [[ -z "${HAPI_API_URL:-}" ]] || SETUP_ENV+=(-e "HAPI_API_URL=$HAPI_API_URL")
  docker run --rm "${SETUP_TTY[@]}" --network host "${SETUP_ENV[@]}" \
    -v "$PROJECT_HAPI_DIR:/home/dev/.hapi" \
    -v "$SCRIPT_DIR/hapi-setup.py:/tmp/hapi-setup.py:ro" \
    "$IMAGE" python3 /tmp/hapi-setup.py setup
  docker run -d "${RUNTIME_ARGS[@]}" "$IMAGE" \
    hapi runner start-sync --workspace-root "$WORKDIR_IN_CONTAINER"
  check_runner
else
  REMOVE_ARGS=(--rm)
  [[ "$PERSISTENT" -eq 0 ]] || REMOVE_ARGS=()
  docker run "${REMOVE_ARGS[@]}" -it "${RUNTIME_ARGS[@]}" "$IMAGE"
fi
